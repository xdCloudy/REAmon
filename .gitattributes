# Ensure shell scripts always use LF line endings (prevents Windows CRLF issues)
*.sh text eol=lf
*.py text eol=lf
*.patch text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# These generated registries are hashed into the generated RoE prompt.
recon_settings/registry.json text eol=lf
webapp/src/lib/reconSettings/registry.json text eol=lf
# Never EOL-convert binaries: the bundled incident-intel seed is sha256-pinned,
# so a converted copy would be refused and the offline fallback lost.
*.gz binary
# Benchmark JSON is provenance-hashed; keep checkout bytes stable across platforms.
tooling/benchmarks/**/*.json text eol=lf
# Fixture dependency manifests are SHA-256-pinned by benchmark builders.
tooling/benchmarks/**/requirements.txt text eol=lf
# Fixture license texts are also pinned as builder inputs.
tooling/benchmarks/**/LICENSE text eol=lf
# Go inventory holdout source and manifests are SHA-256-pinned across hosts.
agentic/reamon_gorefactor/testdata/project_inventory_holdout_v1/** text eol=lf
# Explicit-alias upstream source, license, and synthetic controls are SHA-256-pinned.
agentic/reamon_gorefactor/testdata/upstream_pkg_errors_v0_9_1/** text eol=lf
agentic/reamon_gorefactor/testdata/project_alias_holdout_controls/** text eol=lf
# Recovered JVM source and textual benchmark outputs carry exact hash provenance.
tooling/benchmarks/**/runs/**/*.java text eol=lf
tooling/benchmarks/**/runs/**/*.tsv text eol=lf
tooling/benchmarks/**/runs/**/*.txt text eol=lf
agentic/reamon_gorefactor/testdata/upstream_jsonparser_v1_1_1/** text eol=lf
agentic/reamon_gorefactor/testdata/upstream_goldmark_v1_7_8/** text eol=lf
