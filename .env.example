# REAmon deployment configuration
#
# `./reamon.sh install` generates missing secrets in .env. Set explicit values
# here when deploying non-interactively. Never commit the real .env or target
# artifacts.

# -----------------------------------------------------------------------------
# Required secrets
# -----------------------------------------------------------------------------
POSTGRES_USER=reamon
POSTGRES_PASSWORD=
POSTGRES_DB=reamon
NEO4J_PASSWORD=
AUTH_SECRET=
INTERNAL_API_KEY=

# -----------------------------------------------------------------------------
# REAmon workspace limits
# -----------------------------------------------------------------------------
REAMON_MAX_ARTIFACT_BYTES=536870912
REAMON_MAX_IMPORT_FILES=50000
REAMON_MAX_IMPORT_BYTES=8589934592
REAMON_MAX_RESULT_BYTES=2097152
REAMON_CRUBY_ISEQ_MEM=512m
REAMON_CRUBY_ISEQ_PIDS=16
REAMON_CRUBY_ISEQ_CPUS=1
REAMON_CRUBY_ISEQ_TMP_SIZE=32m
REAMON_CRUBY_ISEQ_MAX_INPUT_BYTES=16777216
REAMON_CRUBY_ISEQ_MAX_OUTPUT_BYTES=524288
REAMON_CRUBY_ISEQ_TIMEOUT_SECONDS=35
REAMON_IMPORT_RETENTION_DAYS=90
REAMON_SERVER_SOURCE_ROOTS=
REAMON_PROCESS_TIMEOUT_MS=60000
REAMON_MAX_PROCESS_OUTPUT_BYTES=2097152
REAMON_DB_PUSH_ACCEPT_DATA_LOSS=false
# Maximum Java/Smali code units indexed from one JADX run (bounded by 5,000).
REAMON_JADX_MAX_RETURNED_UNITS=5000
# Luau bytecode vector constants: default to vector.create(x, y, z).
# Use size 4 for four-wide targets, or set library/constructor to host APIs
# such as Vector3.new. The configured constructor must exist in the target runtime.
REAMON_LUAU_VECTOR_SIZE=3
REAMON_LUAU_VECTOR_LIBRARY=vector
REAMON_LUAU_VECTOR_CONSTRUCTOR=create

# Background analysis worker
REAMON_WORKER_ID=
REAMON_WORKER_POLL_SECONDS=10
REAMON_WORKER_BATCH_SIZE=1
REAMON_WORKER_STALE_AFTER_MINUTES=30
REAMON_WORKER_STALE_SECONDS=90
REAMON_WORKER_BACKFILL_INTERVAL_SECONDS=300
REAMON_WORKER_BACKFILL_BATCH_SIZE=5
REAMON_WORKER_RETENTION_INTERVAL_SECONDS=86400
REAMON_WORKER_RETENTION_APPLY=false
# Optional best-effort webhook for failed provider dispatches.
# REAMON_WORKER_ALERT_WEBHOOK_URL=
# REAMON_WORKER_ALERT_WEBHOOK_TOKEN=

# -----------------------------------------------------------------------------
# Browser and deployment boundaries
# -----------------------------------------------------------------------------
TRUST_PROXY=false
AUTH_COOKIE_SECURE=false
AGENT_WS_MODE=
AGENT_WS_PORT=8090
AGENT_WS_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Release and resource tuning
# -----------------------------------------------------------------------------
REAMON_VERSION=6.23.0
REAMON_WEBAPP_IMAGE=redamon-webapp:latest
POSTGRES_MEM=1g
NEO4J_MEM=1g
AGENT_MEM=2g
WEBAPP_MEM=1g
REAMON_WORKER_MEM=512m
REAMON_WORKER_PIDS=128
REAMON_WORKER_CPUS=1

# Optional host safeguards. These are consumed by the lifecycle entrypoint.
REAMON_SKIP_RAM_GATE=
REAMON_ENABLE_ZRAM=
