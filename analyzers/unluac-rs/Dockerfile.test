FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends lua5.4 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin fixture

ENV NODE_ENV=test
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY worker.mjs unluac-rs.fixture.test.mjs ./
COPY fixtures/ fixtures/
RUN chmod -R a=rX /app
USER 10001:10001

CMD ["node", "--test", "unluac-rs.fixture.test.mjs"]
