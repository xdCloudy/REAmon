FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d

RUN apt-get update \
    && apt-get install -y --no-install-recommends lua5.4=5.4.4-3+deb12u1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin fixture

ENV NODE_ENV=test
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY worker.mjs unluac-rs.fixture.test.mjs ./
COPY fixtures/ fixtures/
RUN chmod -R a=rX /app
USER 10001:10001

CMD ["node", "--test", "unluac-rs.fixture.test.mjs"]
