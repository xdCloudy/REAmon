model Remediation {
  id                String   @id @default(cuid())
  projectId         String   @map("project_id")
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // â”€â”€ Core info â”€â”€
  title             String
  description       String   @db.Text
  severity          String   @default("medium")
  priority          Int      @default(0)
  category          String   @default("vulnerability")
  remediationType   String   @default("code_fix") @map("remediation_type")

  // â”€â”€ Vulnerability evidence â”€â”€
  affectedAssets    Json     @default("[]") @map("affected_assets")
  cvssScore         Float?   @map("cvss_score")
  cveIds            String[] @default([]) @map("cve_ids")
  cweIds            String[] @default([]) @map("cwe_ids")
  capecIds          String[] @default([]) @map("capec_ids")
  evidence          String   @default("") @db.Text
  attackChainPath   String   @default("") @map("attack_chain_path") @db.Text
  exploitAvailable  Boolean  @default(false) @map("exploit_available")
  cisaKev           Boolean  @default(false) @map("cisa_kev")

  // â”€â”€ Remediation details â”€â”€
  solution          String   @default("") @db.Text
  fixComplexity     String   @default("medium") @map("fix_complexity")
  estimatedFiles    Int      @default(0) @map("estimated_files")

  // â”€â”€ GitHub integration â”€â”€
  targetRepo        String   @default("") @map("target_repo")
  targetBranch      String   @default("main") @map("target_branch")
  fixBranch         String   @default("") @map("fix_branch")
  prUrl             String   @default("") @map("pr_url")
  prStatus          String   @default("none") @map("pr_status")

  // â”€â”€ Status tracking â”€â”€
  status            String   @default("pending")
  agentSessionId    String   @default("") @map("agent_session_id")
  agentNotes        String   @default("") @map("agent_notes") @db.Text

  // â”€â”€ File changes (populated by CodeFix agent) â”€â”€
  fileChanges       Json     @default("[]") @map("file_changes")

  // â”€â”€ Link back to the findings and the run that produced this â”€â”€
  // Before these, nothing tied a remediation to a finding: de-duplication
  // relied on the LLM's wording, and a mute could not be reflected here at all.
  // groupKey is the upsert key (one problem, one fix). It is nullable so rows
  // that predate it keep working: Postgres allows many NULLs in a unique index.
  groupKey          String?  @map("group_key")
  findingIds        String[] @default([]) @map("finding_ids")
  liveMemberCount   Int      @default(0) @map("live_member_count")
  priorityScore     Float    @default(0) @map("priority_score")
  triageRunId       String   @default("") @map("triage_run_id")
  // Resolved, but the findings are still being reported. Flagged rather than
  // reopened, so a scan never undoes a human's decision.
  stillDetected     Boolean  @default(false) @map("still_detected")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([projectId, groupKey])
  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([projectId, priority])
  @@map("remediations")
}

// ========== TRIAGE RUNS ==========
// One triage run, as a first-class object the rest of the product can see.
// Before this a run existed only in the agent's memory, so version activation,
// version save, the delta preview, project import and project delete had no way
// to know one was in flight and could swap or delete the graph underneath it.
// It is also the only record of who ranked what, with which model.
model TriageRun {
  id                String    @id @default(cuid())
  projectId         String    @map("project_id")
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // The ticket's `sub`: the effective user, which for an admin acting as
  // someone else is that someone else. realActorUserId is the admin behind it,
  // so "who actually did this" survives simulation.
  actorUserId       String    @map("actor_user_id")
  realActorUserId   String?   @map("real_actor_user_id")

  // running | publishing | completed | completed_partial | failed | stopped
  status            String    @default("running")
  startedAt         DateTime  @default(now()) @map("started_at")
  // The agent refreshes this every 30s. A run whose heartbeat has gone stale
  // stops blocking activation: a dead process must not hold a project forever.
  heartbeatAt       DateTime  @default(now()) @map("heartbeat_at")
  finishedAt        DateTime? @map("finished_at")

  model             String    @default("")
  scoreModelVersion String    @default("") @map("score_model_version")
  intelDate         DateTime? @map("intel_date")

  // Counts only: scored, reviewed, cache_hits, not_reviewed, skipped_changed,
  // false_positives, remediations_*, llm_calls. Never finding text.
  summary           Json      @default("{}")
  // A code, never raw provider text: that routinely carries the API key.
  errorClass        String    @default("") @map("error_class")

  // Who started it: `app` (a person's tab) or `mcp` (an external agent). An
  // MCP start is spaced and capped per project, counted from these rows.
  trigger           String    @default("app")
  // The MCP token's id (never the token) for an `mcp` start.
  tokenId           String?   @map("token_id")
  // Where the run is, from its heartbeat, so a caller other than the run's own
  // tab (another tab, an MCP agent) can show it.
  phase             String    @default("")
  progress          Int       @default(0)

  @@index([projectId, status])
  @@index([projectId, trigger, startedAt])
  @@map("triage_runs")
}

// ========== NODE FILTERS ==========
// Rule-based mutes: an operator writes rules per node kind and they add the
// existing `:Muted` label to matching findings, stamped `muted_by = 'rule:...'`.
// The rules and the exemptions live here rather than on the graph, because a
// graph property is deleted by the prune, the recon asset clear, version
// activation and import, and these rows survive all four.

model ProjectNodeFilter {
  projectId    String   @id @map("project_id")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// denylist | allowlist
  mode         String   @default("denylist")
  /// Armed: every new full or partial recon applies the rules to what it writes.
  applyToScans Boolean  @default(false) @map("apply_to_scans")
  rules        Json     @default("{\"version\":1,\"kinds\":{}}")
  /// Bumped on every save; the stale-write check and "changed since last apply".
  revision     Int      @default(0)
  /// { name, fingerprint } of the preset last loaded; the header badges its name while the rules still hash to it
  loadedPreset Json?    @map("loaded_preset")
  updatedBy    String?  @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("project_node_filters")
}

/// One "apply to current graph". A live row is a graph writer (lib/graphWriters.ts).
model NodeFilterRun {
  id              String    @id @default(cuid())
  projectId       String    @map("project_id")
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorUserId     String    @map("actor_user_id")
  realActorUserId String?   @map("real_actor_user_id")
  /// running | completed | failed | stopped
  status          String    @default("running")
  /// current | both
  target          String
  versionId       String    @map("version_id")
  /// The rules revision this run applies.
  revision        Int
  /// Snapshot of the rules at start: the agent applies exactly this, never a request body.
  rules           Json
  mode            String
  /// Counts only: muted, unmuted, guarded, exempt, per kind and rule.
  stats           Json?
  error           String?
  startedAt       DateTime  @default(now()) @map("started_at")
  heartbeatAt     DateTime  @default(now()) @map("heartbeat_at")
  finishedAt      DateTime? @map("finished_at")

  @@index([projectId, status])
  @@map("node_filter_runs")
}

/// A node an operator unmuted: no rule may mute it again until the exemption is cleared.
model NodeFilterExemption {
  id              String   @id @default(cuid())
  projectId       String   @map("project_id")
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The functional label, one of the muteable finding labels.
  label           String
  /// The natural key: id, or finding_id for MalPackageFinding.
  nodeKey         String   @map("node_key")
  createdBy       String   @map("created_by")
  realActorUserId String?  @map("real_actor_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([projectId, label, nodeKey])
  @@map("node_filter_exemptions")
}

