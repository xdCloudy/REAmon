model UserTradecraftResource {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                 String
  // Server-generated stable identifier the agent uses as resource_id.
  // Lowercase kebab-case from `name` with collision suffix (e.g. "hacktricks", "hacktricks-2").
  // Stable across renames so in-flight conversations and cache rows don't break.
  slug                 String
  url                  String
  enabled              Boolean  @default(true)

  // mkdocs-wiki | github-repo | cve-poc-db | sphinx-docs | gitbook | agentic-crawl
  resourceType         String   @default("agentic-crawl") @map("resource_type")
  summary              String   @default("") @db.Text
  sitemap              Json     @default("{}")

  // Crawl-only metadata (only set when resourceType=agentic-crawl):
  crawlStoppedBecause  String   @default("") @map("crawl_stopped_because")
  crawlStats           Json     @default("{}") @map("crawl_stats")

  // LLM model used for crawl decisions + summary at verify time. Empty string
  // means "fall back to the project's agent model" (same convention as
  // Project.cypherfixLlmModel). Lets the user pick a cheaper/faster model
  // for tradecraft ingestion without changing the chat model.
  llmModel             String   @default("") @map("llm_model")

  // Auth + caching tunables
  githubTokenOverride  String   @default("") @map("github_token_override")
  cacheTtlSec          Int      @default(0) @map("cache_ttl_sec")

  // Lifecycle
  lastVerifiedAt       DateTime? @map("last_verified_at")
  lastRefreshedAt      DateTime? @map("last_refreshed_at")
  lastError            String   @default("") @map("last_error") @db.Text
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([userId, url])
  @@unique([userId, slug])
  @@index([userId])
  @@map("user_tradecraft_resources")
}

// ========== REAMON INVESTIGATION FOUNDATION ==========
// These models are intentionally small. Platform-specific metadata lives in
// JSON profiles, while stable ownership, lifecycle, and cross-entity links stay
// relational so the workspace dashboard remains deterministic and queryable.

model Target {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  targetType  String   @default("UNKNOWN") @map("target_type")
  locator     String?
  parentTargetId String? @map("parent_target_id")
  parentTarget Target? @relation("TargetHierarchy", fields: [parentTargetId], references: [id], onDelete: SetNull)
  childTargets Target[] @relation("TargetHierarchy")
  status      String   @default("DISCOVERED")
  profile     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  artifacts   Artifact[]
  tasks       Task[]
  findings    Finding[]
  hypotheses  Hypothesis[]
  evidence    Evidence[]
  observations ReamonObservation[]
  rootImports WorkspaceImport[] @relation("WorkspaceImportRootTarget")

  @@index([projectId, status])
  @@index([projectId, targetType])
  @@index([parentTargetId])
  @@map("reamon_targets")
}

model Artifact {
  id             String   @id @default(cuid())
  projectId      String   @map("project_id")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetId       String?  @map("target_id")
  target         Target?  @relation(fields: [targetId], references: [id], onDelete: SetNull)
  importId       String?  @map("import_id")
  workspaceImport WorkspaceImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  name           String
  originalName   String   @map("original_name")
  /// Logical path relative to the imported workspace root; never a disk path.
  relativePath   String   @default("") @map("relative_path")
  parentPath     String   @default("") @map("parent_path")
  storagePath    String   @map("storage_path")
  sha256         String
  sizeBytes      Int      @map("size_bytes")
  mimeType       String   @default("application/octet-stream") @map("mime_type")
  extension      String   @default("")
  status         String   @default("DISCOVERED")
  profile        Json     @default("{}")
  capabilities   String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  tasks          Task[]
  findings       Finding[]
  hypotheses     Hypothesis[]
  evidence       Evidence[]
  observations   ReamonObservation[]
  derivedFrom    ArtifactProvenance[] @relation("ArtifactProvenanceOutput")
  usedAsSource   ArtifactProvenance[] @relation("ArtifactProvenanceInput")

  @@index([projectId, status])
  @@index([projectId, sha256])
  @@index([targetId])
  @@index([projectId, relativePath])
  @@index([importId, relativePath])
  @@map("reamon_artifacts")
}

/// Immutable, project-scoped lineage for an artifact produced from one or
/// more existing artifacts. The join shape intentionally supports fan-in so
/// a future provider can produce one output from a whole input set.
model ArtifactProvenance {
  id               String   @id @default(cuid())
  projectId        String   @map("project_id")
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifactId       String   @map("artifact_id")
  artifact         Artifact @relation("ArtifactProvenanceOutput", fields: [artifactId], references: [id], onDelete: Cascade)
  sourceArtifactId String   @map("source_artifact_id")
  sourceArtifact   Artifact @relation("ArtifactProvenanceInput", fields: [sourceArtifactId], references: [id], onDelete: Cascade)
  taskId           String?  @map("task_id")
  task             Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  relation         String   @default("DERIVED_FROM")
  /// Stable idempotency key: output, source, task, and relation.
  provenanceKey    String   @unique @map("provenance_key")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([projectId, artifactId])
  @@index([projectId, sourceArtifactId])
  @@index([projectId, taskId])
  @@map("reamon_artifact_provenance")
}

model WorkspaceImport {
  id             String   @id @default(cuid())
  projectId      String   @map("project_id")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rootTargetId   String?  @unique @map("root_target_id")
  rootTarget     Target?  @relation("WorkspaceImportRootTarget", fields: [rootTargetId], references: [id], onDelete: SetNull)
  sourceType     String   @default("BROWSER_DIRECTORY") @map("source_type")
  rootName       String   @map("root_name")
  status         String   @default("PENDING")
  totalFiles     Int      @default(0) @map("total_files")
  completedFiles Int      @default(0) @map("completed_files")
  failedFiles    Int      @default(0) @map("failed_files")
  totalBytes     BigInt   @default(0) @map("total_bytes")
  uploadedBytes  BigInt   @default(0) @map("uploaded_bytes")
  /// Canonical inventory entries: relativePath, size, and lastModified only.
  manifest       Json     @default("[]")
  metadata       Json     @default("{}")
  errorSummary   String   @default("") @map("error_summary") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  completedAt    DateTime? @map("completed_at")
  artifacts      Artifact[]

  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@map("reamon_workspace_imports")
}

model ReamonProvider {
  id                 String   @id @default(cuid())
  pluginId           String   @unique @map("plugin_id")
  name               String
  category           String
  integration        String
  acceptsTargetTypes String[] @default([]) @map("accepts_target_types")
  acceptsFormats     String[] @default([]) @map("accepts_formats")
  capabilities       String[] @default([])
  produces           String[] @default([])
  requirements       Json     @default("[]")
  enabled            Boolean  @default(true)
  version            String   @default("1")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  tasks              Task[]

  @@index([enabled])
  @@map("reamon_providers")
}

model ReamonWorker {
  id                    String   @id @default(cuid())
  workerId              String   @unique @map("worker_id")
  status                String   @default("IDLE")
  lastSeenAt            DateTime @map("last_seen_at")
  lastDispatchAt        DateTime? @map("last_dispatch_at")
  lastDispatchDurationMs Int?    @map("last_dispatch_duration_ms")
  lastRecovered         Int      @default(0) @map("last_recovered")
  lastSelected          Int      @default(0) @map("last_selected")
  lastCompleted         Int      @default(0) @map("last_completed")
  lastFailed            Int      @default(0) @map("last_failed")
  lastError             String   @default("") @map("last_error") @db.Text
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([status, lastSeenAt])
  @@map("reamon_workers")
}

model ReamonProjectionRun {
  id              String    @id @default(cuid())
  projectionRunId String    @unique @map("projection_run_id")
  projectId       String    @map("project_id")
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status          String    @default("RUNNING")
  offset          Int       @default(0)
  selected        Int       @default(0)
  nodes           Int       @default(0)
  relationships   Int       @default(0)
  truncated       Boolean   @default(false)
  reconciled      Boolean   @default(false)
  deletedNodes    Int       @default(0) @map("deleted_nodes")
  deletedRelationships Int  @default(0) @map("deleted_relationships")
  error           String    @default("") @db.Text
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([projectId, startedAt])
  @@index([status, startedAt])
  @@map("reamon_projection_runs")
}

/// Short-lived project-scoped fencing lease for paginated graph projection.
/// It prevents two backfill workers from reconciling the same project at once.
model ReamonProjectionLease {
  projectId       String   @id @map("project_id")
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectionRunId String   @unique @map("projection_run_id")
  leaseUntil      DateTime @map("lease_until")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([leaseUntil])
  @@map("reamon_projection_leases")
}

model Task {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetId    String?  @map("target_id")
  target      Target?  @relation(fields: [targetId], references: [id], onDelete: SetNull)
  artifactId  String?  @map("artifact_id")
  artifact    Artifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  providerId  String?  @map("provider_id")
  provider    ReamonProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  capability  String?
  title       String
  category    String   @default("analysis")
  status      String   @default("QUEUED")
  progress    Int      @default(0)
  progressMessage String @default("") @map("progress_message")
  options     Json     @default("{}")
  result      Json?
  error       String   @default("") @db.Text
  runToken    String?  @map("run_token")
  idempotencyKey String? @unique @map("idempotency_key")
  startedAt   DateTime? @map("started_at")
  leaseHeartbeatAt DateTime? @map("lease_heartbeat_at")
  leaseOwner  String?  @map("lease_owner")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  observations ReamonObservation[]
  provenance  ArtifactProvenance[]
  approval    ReamonApproval?
  findings    Finding[]

  @@index([projectId, status])
  @@index([projectId, category])
  @@index([projectId, providerId, capability])
  @@index([status, startedAt])
  @@index([status, leaseHeartbeatAt])
  @@index([status, leaseOwner])
  @@map("reamon_tasks")
}

/// A durable operator decision for work that should not execute immediately.
/// The task remains outside the worker's QUEUED state until approval is granted.
model ReamonApproval {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String   @unique @map("task_id")
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING")
  requestedBy String   @default("system") @map("requested_by")
  decidedBy   String?  @map("decided_by")
  reason      String   @default("") @db.Text
  requestedAt DateTime @default(now()) @map("requested_at")
  decidedAt   DateTime? @map("decided_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@index([projectId, createdAt])
  @@map("reamon_approvals")
}

model Finding {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetId    String?  @map("target_id")
  target      Target?  @relation(fields: [targetId], references: [id], onDelete: SetNull)
  artifactId  String?  @map("artifact_id")
  artifact    Artifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  taskId      String?  @map("task_id")
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title       String
  description String   @default("") @db.Text
  severity    String   @default("info")
  status      String   @default("OPEN")
  source      String   @default("system")
  stableKey   String?  @map("stable_key")
  data        Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([projectId, taskId])
  @@index([projectId, source])
  @@map("reamon_findings")
}

model Hypothesis {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetId    String?  @map("target_id")
  target      Target?  @relation(fields: [targetId], references: [id], onDelete: SetNull)
  artifactId  String?  @map("artifact_id")
  artifact    Artifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  statement   String   @db.Text
  status      String   @default("OPEN")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([projectId, status])
  @@map("reamon_hypotheses")
}

model Evidence {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetId    String?  @map("target_id")
  target      Target?  @relation(fields: [targetId], references: [id], onDelete: SetNull)
  artifactId  String?  @map("artifact_id")
  artifact    Artifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  kind        String   @default("observation")
  summary     String   @db.Text
  source      String   @default("system")
  data        Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@index([targetId])
  @@index([artifactId])
  @@map("reamon_evidence")
}

/// A normalized provider observation. The relational shape is the durable
/// source of truth for workspace queries; a future graph projector can turn
/// entity/relationship rows into Neo4j nodes and edges without re-running a
/// provider.
model ReamonObservation {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?  @map("task_id")
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  targetId    String?  @map("target_id")
  target      Target?  @relation(fields: [targetId], references: [id], onDelete: SetNull)
  artifactId  String?  @map("artifact_id")
  artifact    Artifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  kind        String
  type        String
  stableKey   String   @map("stable_key")
  canonicalKey String  @map("canonical_key")
  label       String?
  source      String
  relation    String?
  fromKey     String?  @map("from_key")
  toKey       String?  @map("to_key")
  fromCanonicalKey String? @map("from_canonical_key")
  toCanonicalKey   String? @map("to_canonical_key")
  attributes  Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([projectId, source, stableKey])
  @@index([projectId, canonicalKey])
  @@index([projectId, kind, type])
  @@index([projectId, taskId])
  @@index([projectId, artifactId])
  @@map("reamon_observations")
}

model WorkspaceActivity {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       String   @default("system")
  eventType   String   @map("event_type")
  message     String   @db.Text
  data        Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("reamon_workspace_activities")
}
